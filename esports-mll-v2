#include <iostream>
#include <string>
#include <limits>
using namespace std;

// ini ADT
// Child: elemen Pertandingan
struct Pertandingan {
    int id;             // kunci child (unik di dalam satu turnamen)
    string timA;
    string timB;
    int skorA;
    int skorB;
    string status;      // Dijadwalkan / Berlangsung / Selesai
    Pertandingan* next; // pointer ke child berikutnya
};

// Parent: elemen Turnamen
struct Turnamen {
    int id;             
    string nama;
    string game;
    long long prizePool;
    Pertandingan* childHead; 
    Turnamen* next;          
};

// List utama (Parent List)
struct ListTurnamen {
    Turnamen* head;
};

// Helper input
int readInt(const string& prompt) {
    int x;
    while (true) {
        cout << prompt;
        if (cin >> x) {
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            return x;
        }
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        cout << "Input harus berupa angka, coba lagi.\n";
